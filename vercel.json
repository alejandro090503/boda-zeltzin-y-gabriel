{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.ics",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/calendar; charset=utf-8"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/album",
      "destination": "https://panel-invitados.vercel.app/subir/boda-zeltzin-y-gabriel",
      "permanent": false
    }
  ]
}
